generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  INVITED
  ONBOARDING
  KYB_PENDING
  UNDER_REVIEW
  VERIFIED
  RESTRICTED
  SUSPENDED
  REJECTED
}
enum OrderSide {
  NEED_US_SETTLEMENT
  NEED_CUBA_LIQUIDITY
}
enum OrderStatus {
  DRAFT
  SUBMITTED
  COMPLIANCE_REVIEW
  APPROVED
  AWAITING_FUNDING
  FUNDED
  OPEN
  PARTIALLY_MATCHED
  FULLY_MATCHED
  SETTLEMENT_PENDING
  SETTLED
  CANCELLED
  REJECTED
  ON_HOLD
}

model Organization {
  id             String             @id @default(uuid())
  legalName      String
  registrationNo String?
  taxId          String?
  country        String
  status         OrganizationStatus @default(INVITED)
  expectedMonthlyVolumeMinor BigInt @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  orders         Order[]
}

model Order {
  id             String      @id @default(uuid())
  organizationId String
  side           OrderSide
  amountMinor    BigInt
  matchedMinor   BigInt      @default(0)
  feeBps         Int
  purposeCode    String
  status         OrderStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields:[organizationId], references:[id])
  leftAllocations Allocation[] @relation("LeftOrder")
  rightAllocations Allocation[] @relation("RightOrder")
  @@index([side,status,createdAt])
}

model Allocation {
  id           String @id @default(uuid())
  leftOrderId  String
  rightOrderId String
  amountMinor  BigInt
  createdAt    DateTime @default(now())
  leftOrder    Order @relation("LeftOrder", fields:[leftOrderId], references:[id])
  rightOrder   Order @relation("RightOrder", fields:[rightOrderId], references:[id])
}

model LedgerAccount {
  id        String @id @default(uuid())
  code      String @unique
  name      String
  createdAt DateTime @default(now())
  lines     JournalLine[]
}

model JournalEntry {
  id          String @id @default(uuid())
  reference   String @unique
  description String
  createdAt   DateTime @default(now())
  lines       JournalLine[]
}

model JournalLine {
  id             String @id @default(uuid())
  journalEntryId String
  ledgerAccountId String
  debitMinor     BigInt @default(0)
  creditMinor    BigInt @default(0)
  entry          JournalEntry @relation(fields:[journalEntryId], references:[id])
  account        LedgerAccount @relation(fields:[ledgerAccountId], references:[id])
}
