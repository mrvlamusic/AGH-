# Copy to apps/web/.env.local, or run pnpm setup:local to generate a random password.
ADMIN_EMAIL=admin@cubpay.local
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:3000
# Optional locally, REQUIRED on Vercel and for multiple hosts.
# DATABASE_URL=postgresql://cubpay:cubpay@localhost:5432/cubpay
# Optional: absolute file location for a single local host (ignored with DATABASE_URL).
# CUBPAY_DATA_FILE=/absolute/private/path/state.json
# Hosted testing: staging requires PostgreSQL, exact HTTPS APP_ORIGIN,
# non-local ADMIN_EMAIL and ADMIN_PASSWORD of at least 24 characters.
CUBPAY_DEPLOYMENT=local
CUBPAY_MODE=sandbox
# Emergency stop: preserves login/logout and read access, blocks all other POSTs.
CUBPAY_OPERATIONS_PAUSED=false
